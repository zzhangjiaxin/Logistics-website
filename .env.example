# 前端环境变量配置示例文件
# 复制此文件为 .env.local 并修改相应配置

# 应用标题
VITE_APP_TITLE=物流网站后台管理系统

# API 基础URL - 开发环境
VITE_API_BASE_URL=http://localhost:8080/api

# 租户ID - 默认租户
VITE_TENANT_ID=1

# 是否启用Mock数据
VITE_USE_MOCK=false

# 是否启用调试模式
VITE_DEBUG=true

# 上传文件大小限制（MB）
VITE_UPLOAD_SIZE_LIMIT=10

# API 请求超时时间（毫秒）
VITE_API_TIMEOUT=10000
